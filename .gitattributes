# Normalise line endings: LF in the repository for all text files,
# consistent checkouts across Windows/macOS/Linux (silences CRLF warnings).
* text=auto

*.py     text eol=lf
*.js     text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.md     text eol=lf
*.json   text eol=lf
*.jsonl  text eol=lf
*.txt    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf

# Binary files (never convert or diff as text)
*.pptx   binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.zip    binary
